{
  "name": "quiz-fill-extension",
  "version": "0.1.0",
  "description": "AI-powered browser extension that auto-fills quiz and survey forms using LLMs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt dev --browser chrome",
    "dev:firefox": "wxt dev --browser firefox",
    "build": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox",
    "build:all": "wxt build --browser chrome && wxt build --browser firefox",
    "zip": "wxt zip --browser chrome",
    "zip:firefox": "wxt zip --browser firefox",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.6.82",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.10.7",
    "typescript": "^5.5.4",
    "wxt": "^0.19.0"
  }
}
